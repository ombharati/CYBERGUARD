# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=*

# Database (PostgreSQL)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://cyberguard:cyberguard@localhost:5432/cyberguard

# Redis & Queue
REDIS_URL=redis://localhost:6379/0
SCAN_QUEUE_NAME=cyberguard:scans
SCAN_TIMEOUT_SECONDS=60
MAX_SCAN_RETRIES=2

# Local AI - Ollama (Qwen)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=30.0

# Local AI - Laya (URL System 1 Decision Model)
# Path to virtual environment or site-packages containing laya
LAYA_VENV_PATH=
LAYA_DEVICE=cpu
LAYA_TIMEOUT_SECONDS=15.0

# External Threat Intelligence (Optional)
ENABLE_EXTERNAL_INTEL=false
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
EXTERNAL_INTEL_TIMEOUT_SECONDS=5.0
